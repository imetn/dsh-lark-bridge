# Feishu/Lark app credentials. Never commit real values.
DSH_LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
DSH_LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Closed by default. Add your own open_id values, separated by commas.
DSH_LARK_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx
DSH_LARK_ALLOWED_CHAT_IDS=

# Development bootstrap only; keep false in production.
DSH_LARK_ALLOW_ALL_USERS=false
DSH_LARK_ALLOW_ALL_GROUPS=false
